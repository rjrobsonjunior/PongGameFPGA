set_global_assignment -name IP_TOOL_NAME "LPM_CONSTANT"
set_global_assignment -name IP_TOOL_VERSION "18.1"
set_global_assignment -name IP_GENERATED_DEVICE_FAMILY "{MAX 10}"
set_global_assignment -name VHDL_FILE [file join $::quartus(qip_path) "gravity_value.vhd"]
set_global_assignment -name MISC_FILE [file join $::quartus(qip_path) "gravity_value.bsf"]
set_global_assignment -name MISC_FILE [file join $::quartus(qip_path) "gravity_value.cmp"]
